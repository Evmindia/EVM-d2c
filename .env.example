# =============================================================================
# EVM D2C — Environment template. Copy to .env.local and fill per-environment.
# NEVER put real secrets in this file. NEVER commit .env.local.
# No secret may use the NEXT_PUBLIC_ prefix (those are exposed to the browser).
# =============================================================================

# ---- App environment: development | staging | production --------------------
APP_ENV=development

# ---- Public site URL (drives canonical/sitemap/robots/OG) -------------------
# PENDING — Final D2C subdomain (<FINAL_D2C_SUBDOMAIN>) not yet decided by EVM.
# Use a placeholder in dev; change ONLY this value when the domain is finalized.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Firebase Web (PUBLIC config — safe to expose in the browser, NOT secrets)
# These are the BROWSER Firebase config values. Source: Firebase Console →
# Project settings → General → "Your apps" → Web app → SDK setup (Config).
# They are consumed only by src/lib/firebase/client.ts ('use client').
# DEV project: evm-d2c-dev  (auth domain is typically evm-d2c-dev.firebaseapp.com,
# storage bucket evm-d2c-dev.appspot.com — copy the exact values from the console).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SERVER-ONLY SECRETS — never NEXT_PUBLIC_, never client) --
# Consumed only by src/lib/firebase/admin.ts (imports 'server-only'; reads via
# the server-only src/lib/config/server-env.ts). NEVER goes to the browser.
#
# Fill these in .env.local (which is git-ignored) from the Firebase Admin SDK
# private-key JSON you downloaded for DEV project "evm-d2c-dev". Map the JSON
# fields as follows (do NOT commit the JSON; do NOT paste it into chat):
#   JSON "project_id"    ->  FIREBASE_ADMIN_PROJECT_ID   (e.g. evm-d2c-dev)
#   JSON "client_email"  ->  FIREBASE_ADMIN_CLIENT_EMAIL (…@evm-d2c-dev.iam.gserviceaccount.com)
#   JSON "private_key"   ->  FIREBASE_ADMIN_PRIVATE_KEY
#
# PRIVATE KEY formatting: wrap the whole value in double quotes and keep the
# literal "\n" sequences (do not turn them into real newlines). The code calls
# .replace(/\\n/g, '\n') to restore newlines at runtime. Example shape only:
#   FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- Payment provider --------------------------------------------------------
# One of: pending | razorpay | cashfree. Pilot uses Razorpay (set to 'razorpay').
# The provider is selected here; Razorpay-specific code lives only in the adapter.
PAYMENT_PROVIDER=pending
# Generic provider secrets (server-only) — optional; Razorpay uses RAZORPAY_* below.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- Razorpay (server-only secrets) -----------------------------------------
# Use TEST/SANDBOX credentials in development. NEVER commit real credentials.
# key_id is public (returned to the browser by the API for Razorpay Checkout).
# key_secret and webhook_secret must NEVER be exposed to the browser or logged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shipping provider: eShipz (multi-carrier aggregator) — SERVER-ONLY ------
# Read by src/lib/eshipz/* (all 'server-only'). When unset, the admin fulfillment
# flow uses a clearly-marked PLACEHOLDER AWB; once set, real eShipz shipments are
# created automatically. eShipz auto-selects the carrier (rule-based) and returns
# tracking — we never pin a courier.
ESHIPZ_BASE_URL=https://app.eshipz.com
ESHIPZ_EMAIL=
ESHIPZ_PASSWORD=
# v2 login needs no API key; set ESHIPZ_USE_V2_LOGIN=false + this only to force v1.
ESHIPZ_API_KEY=
ESHIPZ_USE_V2_LOGIN=true
# Auto carrier selection via eShipz Automation Rules (recommended). Set false +
# ESHIPZ_CARRIER_SLUG to force a specific courier.
ESHIPZ_USE_RULE_BASED=true
ESHIPZ_CARRIER_SLUG=
ESHIPZ_VENDOR_ID=
ESHIPZ_SERVICE_TYPE=
# Warehouse / pickup (ship_from) — configure the warehouse in the eShipz
# dashboard and mirror its address here. Pincode is also the serviceability origin.
ESHIPZ_SHIP_FROM_NAME=
ESHIPZ_SHIP_FROM_COMPANY=
ESHIPZ_SHIP_FROM_STREET1=
ESHIPZ_SHIP_FROM_STREET2=
ESHIPZ_SHIP_FROM_CITY=
ESHIPZ_SHIP_FROM_STATE=
ESHIPZ_SHIP_FROM_PINCODE=
ESHIPZ_SHIP_FROM_COUNTRY=IN
ESHIPZ_SHIP_FROM_PHONE=
ESHIPZ_SHIP_FROM_EMAIL=
# Safety-net weight (kg) used ONLY when a product has no weightGrams set.
ESHIPZ_FALLBACK_WEIGHT_KG=0.5

# ---- (DEPRECATED) BlueDart direct — replaced by eShipz above -----------------
# Read by src/lib/bluedart/* (all 'server-only'). When these are unset, the admin
# fulfillment flow uses a clearly-marked PLACEHOLDER AWB; once set, the real
# GenerateWayBill call is used automatically. No code change needed.
SHIPPING_PROVIDER=bluedart
#
# APIGEE base URL + proxy paths (get exact paths from the downloaded Swagger).
BLUEDART_BASE_URL=
BLUEDART_TOKEN_PATH=
BLUEDART_WAYBILL_PATH=
BLUEDART_TRACKING_PATH=
BLUEDART_SERVICEABILITY_PATH=
# Auth header/param names (confirm from Swagger; defaults are best-guess).
BLUEDART_SECRET_HEADER=ClientSecret
BLUEDART_CLIENTID_PARAM=ClientID
BLUEDART_TOKEN_HEADER=JWTToken
# App credentials (from the DHL developer portal App) — sandbox + prod.
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
# Production only (from regional BlueDart office, manual verification).
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=
# Our BlueDart account + pickup (Shipper) details.
BLUEDART_CUSTOMER_CODE=
BLUEDART_ORIGIN_AREA=
BLUEDART_SHIPPER_NAME=
BLUEDART_SHIPPER_ADDRESS1=
BLUEDART_SHIPPER_ADDRESS2=
BLUEDART_SHIPPER_ADDRESS3=
BLUEDART_SHIPPER_PINCODE=
BLUEDART_SHIPPER_MOBILE=
BLUEDART_SHIPPER_EMAIL=
# Shipment defaults.
BLUEDART_PRODUCT_CODE=A
BLUEDART_DEFAULT_WEIGHT_KG=0.5

# ---- OTP SMS gateway: Kapsystem (India, DLT) — SERVER-ONLY ------------------
# Login OTP is sent via Kapsystem (not Firebase). The OTP message body MUST match
# your DLT-approved content template exactly — put that text in KAPSYSTEM_OTP_TEMPLATE
# with a {otp} placeholder. All values are server-only (never NEXT_PUBLIC_).
KAPSYSTEM_BASE_URL=https://api.kapsystem.com/sms/1/text/query
KAPSYSTEM_USERNAME=
KAPSYSTEM_PASSWORD=
KAPSYSTEM_FROM=
KAPSYSTEM_DLT_CONTENT_TEMPLATE_ID=
KAPSYSTEM_DLT_PRINCIPAL_ENTITY_ID=
KAPSYSTEM_DLT_TELEMARKETER_ID=
# Must match the DLT template text exactly; {otp} is replaced with the code.
KAPSYSTEM_OTP_TEMPLATE=Your EVM OTP is {otp}. Valid for 5 minutes. Do not share it.

# ---- Rate limiting ----------------------------------------------------------
# memory (dev default) | upstash (preferred prod) | firestore (fallback)
RATE_LIMIT_PROVIDER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Analytics — PENDING IDs ------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=
